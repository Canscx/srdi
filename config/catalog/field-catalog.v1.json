    },
    {
      "key": "company.creditCode", "label": "统一社会信用代码", "type": "text", "dataClass": "A",
      "docTypes": ["application", "cert", "tax"],
      "aliases": ["统一社会信用代码", "信用代码", "纳税人识别号"],
